# CyberProduct Frontend Environment Configuration
# Copy this file to .env for local development.
# In Vercel, configure this variable in Project Settings -> Environment Variables.
# NEVER include database secrets, Supabase service-role keys, or private tokens here.

# Backend API Base URL (no trailing slash)
# Local development default: http://localhost:3000
# Vercel production deployment: https://<your-production-backend-domain>
VITE_API_BASE_URL=https://<your-production-backend-domain>
